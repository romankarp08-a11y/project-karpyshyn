@startuml
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam actorStyle awesome
skinparam rectangle {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1565C0
}

header Проєкт: Інтернет-магазин одягу «TrendWave» | Автор: Карпишин Роман (КН-4)
title Діаграма варіантів використання (Use Case Diagram)
footer Версія: v1.0 | Дата: 28.11.2026

actor "Гість" as Guest
actor "Покупець" as Customer
actor "Менеджер" as Manager
actor "Адміністратор" as Admin

' Узагальнення акторів: Покупець успадковує можливості Гостя
Guest <|-- Customer

' Зовнішні системи (праворуч)
actor "Платіжний шлюз\n(Еквайринг)" as PaymentSystem <<system>>
actor "Служба доставки\n(Нова Пошта API)" as DeliverySystem <<system>>

rectangle "Інтернет-магазин одягу «TrendWave»" {
  usecase "UC-01: Переглядати каталог\nта шукати товари" as UC1
  usecase "UC-02: Підібрати розмір\nза параметрами фігури" as UC2
  usecase "UC-03: Керувати кошиком" as UC3
  usecase "UC-04: Оформити замовлення" as UC4
  usecase "UC-05: Оплатити замовлення онлайн" as UC5
  usecase "UC-06: Авторизуватися в системі" as UC6
  usecase "UC-07: Керувати профілем\nта замірами тіла" as UC7
  usecase "UC-08: Відстежувати статус\nзамовлень" as UC8
  usecase "UC-09: Залишити відгук про товар" as UC9
  usecase "UC-10: Керувати каталогом\nта залишками SKU" as UC10
  usecase "UC-11: Обробляти замовлення\nта формувати ТТН" as UC11
  usecase "UC-12: Керувати користувачами\nта ролями" as UC12
}

' Зв'язки Гостя
Guest --> UC1
Guest --> UC2
Guest --> UC3
Guest --> UC4

' Зв'язки Покупця (авторизованого)
Customer --> UC7
Customer --> UC8
Customer --> UC9

' Зв'язки Менеджера
Manager --> UC10
Manager --> UC11

' Зв'язки Адміністратора
Admin --> UC12

' Відношення include та extend
UC7 ..> UC6 : <<include>>
UC8 ..> UC6 : <<include>>
UC9 ..> UC6 : <<include>>
UC10 ..> UC6 : <<include>>
UC11 ..> UC6 : <<include>>
UC12 ..> UC6 : <<include>>

UC5 ..> UC4 : <<extend>>\n[обрано онлайн-оплату]
UC2 ..> UC1 : <<extend>>\n[запит підбору розміру]

' Взаємодія із зовнішніми системами
UC5 --> PaymentSystem
UC11 --> DeliverySystem
@enduml
