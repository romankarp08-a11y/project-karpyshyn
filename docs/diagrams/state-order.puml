@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #0D47A1
  BackgroundColor<<FinalSuccess>> #E8F5E9
  BorderColor<<FinalSuccess>> #2E7D32
  BackgroundColor<<FinalCancel>> #FFEBEE
  BorderColor<<FinalCancel>> #C62828
}

header Проєкт: Інтернет-магазин одягу «TrendWave» | Автор: Карпишин Роман (КН-4)
title Діаграма станів сутності «Замовлення» (Order)
footer Версія: v1.0 | Дата: 28.11.2026

[*] --> Нове : підтвердження кошика

Нове --> ОчікуєОплату : [обрано онлайн-оплату]
Нове --> Підтверджено : [обрано післяплату]
Нове --> Скасовано : скасування покупцем

ОчікуєОплату --> Підтверджено : оплата успішна
ОчікуєОплату --> Скасовано : [час очікування > 24 год]\nабо помилка платежу

Підтверджено : entry / списати залишок SKU
Підтверджено : do / пакування замовлення
Підтверджено --> Відправлено : менеджер додав ТТН
Підтверджено --> Скасовано : скасування до відправки\n/ повернути залишок SKU

Відправлено --> Доставлено : отримано клієнтом у відділенні

state Доставлено <<FinalSuccess>>
state Скасовано <<FinalCancel>>

Доставлено --> [*]
Скасовано --> [*]

legend right
  |= Елемент |= Позначення |
  | ● / ◉ | Початковий / кінцевий стан |
  | [умова] | Умова переходу (guard) |
  | entry / do | Вхідна та внутрішня дії |
endlegend
@enduml
